		lineageTag: 4087a1af-4549-43c1-84e6-31779b21ac26
		summarizeBy: none
		sourceColumn: order_status

	column payment_method
		dataType: string
		lineageTag: f0e7b299-34e2-4b32-8c22-058d81f70743
		summarizeBy: none
		sourceColumn: payment_method

	column channel
		dataType: string
		lineageTag: 743fba5e-fd24-442a-9096-1c719ab84601
		summarizeBy: none
		sourceColumn: channel

	column discount_sar
		dataType: double
		lineageTag: 07ca2d26-48a3-4577-a04b-c5e02a5c70c6
		summarizeBy: sum
		sourceColumn: discount_sar

		annotation SummarizationSetBy = Automatic

	column shipping_fee_sar
		dataType: double
		lineageTag: 17307b46-091f-4435-9819-c7b42d9e7c89
		summarizeBy: sum
		sourceColumn: shipping_fee_sar

		annotation SummarizationSetBy = Automatic

	column order_total_sar
		dataType: double
		lineageTag: ec1fec8e-8613-4ebe-abc1-c1d8b174e30c
		summarizeBy: sum
		sourceColumn: order_total_sar

		annotation SummarizationSetBy = Automatic

	column 'Order Year' = YEAR(Orders[order_date])
		dataType: int64
		lineageTag: 12d6da68-11e6-417d-9be9-7c61c4b7dc3b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Month Start' = DATE(YEAR(Orders[order_date]),MONTH(Orders[order_date]),1)
		dataType: dateTime
		formatString: MMM yyyy
		lineageTag: 7eabfc94-9bc7-49be-a917-226d84918c59
		summarizeBy: none

		variation Variation
			isDefault
			relationship: b699e6f9-3f14-48f5-b081-19e7784579c9
			defaultHierarchy: LocalDateTable_aa764855-2d94-475d-bb71-cdfa8882efad.'Date Hierarchy'

	partition Orders = m
		mode: import
		source =
				let
				    Source = MySQL.Database(MySQL_Server, MySQL_Database, [ReturnSingleDatabase=true]),
				    Data = Source{[Schema=MySQL_Database, Item="orders"]}[Data]
				in
				    Data

